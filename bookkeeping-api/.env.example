# 复制本文件为 .env 并填入真实值；.env 已在 .gitignore 中，不会提交

# MySQL 连接密码（对应 bookkeeping 库的账号）
MYSQL_PASSWORD=your-mysql-password

# MySQL 连接信息（云托管环境填控制台 MySQL 页的内网地址）
# MYSQL_HOST 填 IP 即可；即使整体复制了 "IP:3306" 形式，程序也会自动剥掉端口段
# MYSQL_PORT=3306
# MYSQL_USER=bookkeeping_app
# MYSQL_DATABASE=bookkeeping

# JWT 签名密钥，至少 32 字节；生产环境必须使用随机值
JWT_SECRET=please-generate-a-random-secret-at-least-32-bytes

# 令牌有效期（小时）
JWT_EXPIRE_HOURS=24

# 跨域白名单，多个来源用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
